              └───────┬────────┘  └──────────┬──────────┘
                      │                      │
                      │    ┌─────────────────┘
                      │    │
              ┌───────▼────▼──────────────────┐
              │  Semantic-Guided Combiner     │
              │                               │
              │  Future Occ = M_dyn * Dyn_Pred│
              │             + M_sta * Sta_Pred│
              └───────────────┬───────────────┘
                              │
                    Future 3D Occupancy
                   (t+1, t+2, t+3)
```

#### 实现方法

**1. Semantic Dynamic-Static Separator**

从 SemanticInjector 的 seg_logits 生成动态/静态 mask：

```python
class SemanticDynStaSeparator(nn.Module):
    def __init__(self, num_classes=17,
                 dynamic_classes=[2,3,4,5,6,7,8,9,10]):
        # dynamic_classes = [bicycle, bus, car, construction_vehicle,
        #                    motorcycle, pedestrian, traffic_cone, trailer, truck]
        self.dynamic_weight = nn.Parameter(torch.ones(len(dynamic_classes)))
        self.proj_to_bev = nn.Conv2d(num_classes, 1, 1)  # 投影到 BEV

    def forward(self, seg_logits, depth, frustum):
        # seg_logits: (B*N, 17, H, W) — SemanticInjector 输出
        prob = F.softmax(seg_logits, dim=1)

        # 动态概率（可学习权重）
        dyn_prob_2d = sum(prob[:, c] * w for c, w in
                          zip(self.dynamic_classes, self.dynamic_weight))
        # dyn_prob_2d: (B*N, H, W)

        # 投影到 BEV 空间（复用 LSS 的 frustum + depth 加权池化）
        dyn_mask_bev = project_to_bev(dyn_prob_2d, depth, frustum)
        sta_mask_bev = 1.0 - dyn_mask_bev

        return dyn_mask_bev, sta_mask_bev  # (B, 1, Dy, Dx) each
```

**2. 动态预测分支（Semantic-Guided Temporal Attention）**

```python
class DynamicFuturePredictor(nn.Module):
    def __init__(self, bev_channels=64, num_future=3, num_heads=4):
        self.temporal_attn = nn.MultiheadAttention(
            bev_channels, num_heads, batch_first=True)
        self.future_heads = nn.ModuleList([
            nn.Sequential(
                nn.Conv2d(bev_channels, bev_channels, 3, padding=1),
                nn.BatchNorm2d(bev_channels),
                nn.ReLU(),
                nn.Conv2d(bev_channels, bev_channels, 1),
            ) for _ in range(num_future)
        ])

    def forward(self, fused_bev, dyn_mask):
        # fused_bev: (B, C, Dy, Dx)
        # dyn_mask: (B, 1, Dy, Dx)

        # 用动态 mask 加权特征（聚焦动态区域）
        dyn_feat = fused_bev * dyn_mask  # (B, C, Dy, Dx)

        # 展平为序列做 temporal attention
        B, C, Dy, Dx = dyn_feat.shape
        seq = dyn_feat.flatten(2).transpose(1, 2)  # (B, Dy*Dx, C)
        attn_out, _ = self.temporal_attn(seq, seq, seq)
        attn_out = attn_out.transpose(1, 2).view(B, C, Dy, Dx)

        # 多步未来预测
        future_preds = []
        for head in self.future_heads:
            future_preds.append(head(attn_out))  # (B, C, Dy, Dx)

        return future_preds  # list of (B, C, Dy, Dx), len=num_future
```

**3. 静态预测分支（Ego-Motion Warp）**

```python
class StaticFuturePredictor(nn.Module):
    def forward(self, current_occ_bev, future_ego_poses):
        # current_occ_bev: (B, C, Dy, Dx) — 当前帧 BEV 特征
        # future_ego_poses: list of (4, 4) 变换矩阵

        future_static = []
        for pose in future_ego_poses:
            # 将当前 BEV warp 到未来 ego 坐标系
            warped = warp_bev(current_occ_bev, pose)
            future_static.append(warped)

        return future_static  # list of (B, C, Dy, Dx)
```

**4. Semantic-Guided Combiner**

```python
class SemanticCombiner(nn.Module):
    def forward(self, dyn_preds, sta_preds, dyn_mask, sta_mask, occ_head):
        future_occs = []
        for dyn_p, sta_p in zip(dyn_preds, sta_preds):
            # 语义引导的组合：动态区域用动态预测，静态区域用静态预测
            combined = dyn_p * dyn_mask + sta_p * sta_mask
            # 通过占用头生成 3D 占用
            occ = occ_head(combined)  # (B, 200, 200, 16, 18)
            future_occs.append(occ)

        return future_occs  # list of (B, Dx, Dy, Dz, num_classes)
```

